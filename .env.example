# ──────────────────────────────────────────────────────────────
# JUAN MECÁNICO — Variables de Entorno
# Copia como .env y rellena los valores reales
# NUNCA subas .env al repositorio
# ──────────────────────────────────────────────────────────────

# ── Telegram Bot ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
WEBHOOK_URL=

# ── Google Cloud / Firebase ───────────────────────────────────
GOOGLE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# ── Gemini AI ─────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Config Bot ────────────────────────────────────────────────
BOT_NOMBRE=Juan Mecánico
PRIVACY_URL=
PRIVACY_VERSION=1.0
MAX_FALLAS_ANTES_ALERTA=3
RATE_LIMIT_POR_HORA=15

# ── Servidor ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
